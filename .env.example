# Copy to .env and fill in. Never commit the real .env.
#
# This server has NO built-in client id. You must register your own
# FamilySearch application and supply its credentials, because a production
# key is issued to an application, not to this software.
#
#   https://www.familysearch.org/developers/

# Your registered application's client id.
FS_CLIENT_ID=

# An access token obtained through your application's OAuth flow. The
# gazetteer and the collection catalogue work without one; records, images
# and the tree require it. It lasts about an hour: refresh it here and the
# running server picks it up (see docs/AUTH.md).
FS_ACCESS_TOKEN=

# Optional: 'production' (default) or 'integration' for the sandbox.
# FS_ENVIRONMENT=production

# Optional: HTTP timeout in seconds (default 60).
# FS_TIMEOUT=60
